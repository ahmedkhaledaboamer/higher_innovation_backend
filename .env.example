# Copy to .env and fill in real values. Never commit .env, and never put real
# credentials in this file: it is meant to be committed.
# (Tests do not read either file; they start their own in-memory MongoDB.)

# development | test | production
NODE_ENV=development
PORT=4000

# ------------------------------------------------------------------ database
# MongoDB connection string. Include the database name in the path.
# Local: mongodb+srv://ahmedkhaled:J20rQxo1BaC5whw3@cluster0.rgczhlp.mongodb.net/higher_edu?retryWrites=true&w=majority
# Atlas:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DBNAME?retryWrites=true&w=majority
# Must be a replica set (Atlas always is): the API refuses to start on a standalone
# server, because it relies on transactions.
MONGODB_URI=mongodb+srv://ahmedkhaled:J20rQxo1BaC5whw3@cluster0.rgczhlp.mongodb.net/higher_edu?retryWrites=true&w=majority

# ------------------------------------------------------------------ http
# Frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse proxies in front of the API (0 when running it directly)
TRUST_PROXY=0

# Baseline rate limit per IP: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Swagger UI at /api/docs. Defaults to true outside production when omitted.
# API_DOCS_ENABLED=true

# ------------------------------------------------------------------ authentication
# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Access token lifetime in seconds (60-3600)
ACCESS_TOKEN_TTL_SECONDS=900
# JWT_ISSUER=academy-crm-api
# JWT_AUDIENCE=academy-crm

# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=7

# Refresh-token cookie. COOKIE_SECURE defaults to true in production (HTTPS only).
# COOKIE_SAMESITE: strict when frontend and API share a site (localhost, or app.x.com + api.x.com);
# none only if they are on different sites (then COOKIE_SECURE must be true).
# COOKIE_SECURE=false
COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com

# bcrypt cost factor (production minimum 10)
BCRYPT_ROUNDS=12

# Frontend base URL for links in emails (reset password / invitation)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72

# Stricter per-client limit for login / forgot / reset / change password
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# ------------------------------------------------------------------ email
# outbox = write emails as JSON files to MAIL_OUTBOX_DIR (development only)
# smtp   = real delivery (required in production)
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=.outbox
MAIL_FROM=Academy CRM <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ------------------------------------------------------------------ initial Owner (npm run db:seed)
# Read only by the seed command, and only while no Owner exists.
# Password policy: 10+ characters with a letter and a digit.
# Delete SEED_OWNER_PASSWORD after seeding, then change the password in the app.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=Academy
SEED_OWNER_LAST_NAME=Owner

# ------------------------------------------------------------------ demo data (npm run seed:demo)
# By default only a local database is accepted. To put demo data into a dedicated remote database
# (development only), set this to the exact database name in MONGODB_URI. The database must contain
# nothing but this CRM's collections and demo records, otherwise the seed refuses.
# DEMO_SEED_REMOTE_DATABASE=higher-edu

# ------------------------------------------------------------------ deployment identity (staging)
# Leave unset for local development (setting PRODUCTION_DB_HOST_SHA256 locally makes development refuse
# production hosts too). For staging see docs/STAGING.md and docs/staging.env.template.
# Generate fingerprints offline with: npm run fingerprint:hosts
# DEPLOY_ENV=staging
# PRODUCTION_DB_HOST_SHA256=<sha256 of the production cluster domain, comma-separated>
# STAGING_DB_HOST_SHA256=<sha256 of the exact staging SRV host name>   (staging only)
# STAGING_CONNECTIVITY_APPROVED=false
