{
  "name": "academy-crm-api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the Higher Innovation Academy CRM",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:indexes": "tsx src/scripts/sync-indexes.ts",
    "db:seed:prod": "node dist/scripts/seed.js",
    "db:indexes:prod": "node dist/scripts/sync-indexes.js",
    "seed:demo": "tsx src/scripts/seed-demo-data.ts",
    "preflight:staging": "node dist/scripts/staging-preflight.js",
    "preflight:staging:dev": "tsx src/scripts/staging-preflight.ts",
    "config:check": "tsx src/scripts/check-config.ts",
    "fingerprint:hosts": "tsx src/scripts/host-fingerprints.ts"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.2",
    "nodemailer": "10.1.6",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "bcrypt@6.0.0": true
  }
}
