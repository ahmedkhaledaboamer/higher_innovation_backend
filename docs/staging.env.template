# Staging environment template — PLACEHOLDERS ONLY. Copy the variable names into the platform's
# secret store / environment settings; never commit a filled-in copy. See docs/STAGING.md.
# The offline preflight must report "Automatic checks passed." before connectivity is approved:
#   npm run preflight:staging            (on the staging host, against its real environment)
# This template itself fails the preflight on purpose (placeholders).

# --- identity and isolation
DEPLOY_ENV=staging
NODE_ENV=production
# Fingerprint of the production cluster DOMAIN (<id>.mongodb.net): it also covers the SRV and shard hosts.
PRODUCTION_DB_HOST_SHA256=<sha256-of-production-cluster-domain>
# EXACT fingerprint of the staging SRV host name. With a mongodb:// seed list instead: every seed AND
# every replica set member, exactly. Domain fingerprints are not accepted.
STAGING_DB_HOST_SHA256=<sha256-of-exact-staging-srv-host-name>
STAGING_CONNECTIVITY_APPROVED=false

# --- database (separate staging cluster; database name with "staging" as a separate word, e.g. academy_staging;
#     host names only, no tlsInsecure / tlsAllowInvalid* options)
MONGODB_URI=<mongodb+srv connection string for the STAGING user and a database named like academy_staging>

# --- auth
JWT_ACCESS_SECRET=<new random value, 48+ characters, unique to staging>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- HTTP, CORS, cookies, proxy
PORT=4000
CORS_ORIGINS=<https://staging frontend origin>
FRONTEND_URL=<https://staging frontend URL>
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
TRUST_PROXY=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_DOCS_ENABLED=false
LOG_LEVEL=info

# --- email: SANDBOX SMTP only (capture service, never the production mailbox)
MAIL_TRANSPORT=smtp
MAIL_FROM=<Academy CRM Staging <no-reply@staging domain>>
SMTP_HOST=<sandbox smtp host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<sandbox user>
SMTP_PASS=<sandbox password>
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72
